DAGSTER_HOME=/data/dagster/home
DAGSTER_DATA_DIR=/data/dagster/data
DAGSTER_PORT=3000

S3_KEY_ID=
S3_SECRET=
S3_HOST="storage.heigit.org"
S3_BUCKET="heigit-hdx-public"
HDX_KEY=
HDX_SITE="stage"

OHSOME_QUALITY_API_URL=
OHSOME_API_URL=
HEIGIT_API_KEY=

# request timeouts in seconds, defaults: 120 / 180
OHSOME_QUALITY_API_TIMEOUT=
OHSOME_API_TIMEOUT=

# tolerance (degrees) for simplifying layer geometries before sending them to
# the APIs, default: 0.002. Raise this if a large/complex geometry (e.g. a
# whole-country boundary) times out on the API side.
GEOMETRY_SIMPLIFY_TOLERANCE=